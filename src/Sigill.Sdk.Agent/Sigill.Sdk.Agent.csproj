<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;netstandard2.1</TargetFrameworks>
    <RootNamespace>Sigill.Sdk.Agent</RootNamespace>
    <AssemblyName>Sigill.Sdk.Agent</AssemblyName>
    <PackageId>Sigill.Sdk.Agent</PackageId>
    <Title>Sigill SDK — Agent Evidence Profiles (preview)</Title>
    <Description>Preview: the three sibling profiles for a controlled agent run — Control Artifact (before), Execution Evidence (during, chained) and Control Evaluation (after) — sealed through Sigill's blind sign-hashes contract, plus a verifier for the whole run. Experimental; may be withdrawn.</Description>
    <PackageTags>ai;agent;evidence;audit;jades;chain;control;sigill</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Package reference, not project reference: the profiles build only on the
         published public surface of Sigill.Sdk, exactly like a consumer does, and
         the core is not changed on this branch. -->
    <PackageReference Include="Sigill.Sdk" Version="0.5.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.0" />
    <PackageReference Include="PolySharp" Version="1.14.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
